/*
 * slabV (brickbots/slabv): 36-key unibody, Pro Micro footprint.
 * Same matrix as the chocV in QMK: rows F4 F5 D1 D0,
 * cols B6 B2 B3 B1 F7 C6 D7 E6 B4 B5, diodes COL2ROW.
 * Thumbs are row 4, columns 3-8.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* F4 */
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* F5 */
            , <&pro_micro 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* D1 */
            , <&pro_micro 3  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* D0 */
            ;

        col-gpios
            = <&pro_micro 10 GPIO_ACTIVE_HIGH>  /* B6 */
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>  /* B2 */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>  /* B3 */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>  /* B1 */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>  /* F7 */
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>  /* C6 */
            , <&pro_micro 6  GPIO_ACTIVE_HIGH>  /* D7 */
            , <&pro_micro 7  GPIO_ACTIVE_HIGH>  /* E6 */
            , <&pro_micro 8  GPIO_ACTIVE_HIGH>  /* B4 */
            , <&pro_micro 9  GPIO_ACTIVE_HIGH>  /* B5 */
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <10>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                            RC(3,2) RC(3,3) RC(3,4)   RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    /* Key positions for ZMK Studio, from the chocV QMK layout (units x100). */
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys  /*                 w   h    x    y  rot rx ry */
            = <&key_physical_attrs 100 100    0   30 0 0 0>
            , <&key_physical_attrs 100 100  100   10 0 0 0>
            , <&key_physical_attrs 100 100  200    0 0 0 0>
            , <&key_physical_attrs 100 100  300   10 0 0 0>
            , <&key_physical_attrs 100 100  400   20 0 0 0>
            , <&key_physical_attrs 100 100  800   20 0 0 0>
            , <&key_physical_attrs 100 100  900   10 0 0 0>
            , <&key_physical_attrs 100 100 1000    0 0 0 0>
            , <&key_physical_attrs 100 100 1100   10 0 0 0>
            , <&key_physical_attrs 100 100 1200   30 0 0 0>
            , <&key_physical_attrs 100 100    0  130 0 0 0>
            , <&key_physical_attrs 100 100  100  110 0 0 0>
            , <&key_physical_attrs 100 100  200  100 0 0 0>
            , <&key_physical_attrs 100 100  300  110 0 0 0>
            , <&key_physical_attrs 100 100  400  120 0 0 0>
            , <&key_physical_attrs 100 100  800  120 0 0 0>
            , <&key_physical_attrs 100 100  900  110 0 0 0>
            , <&key_physical_attrs 100 100 1000  100 0 0 0>
            , <&key_physical_attrs 100 100 1100  110 0 0 0>
            , <&key_physical_attrs 100 100 1200  130 0 0 0>
            , <&key_physical_attrs 100 100    0  230 0 0 0>
            , <&key_physical_attrs 100 100  100  210 0 0 0>
            , <&key_physical_attrs 100 100  200  200 0 0 0>
            , <&key_physical_attrs 100 100  300  210 0 0 0>
            , <&key_physical_attrs 100 100  400  220 0 0 0>
            , <&key_physical_attrs 100 100  800  220 0 0 0>
            , <&key_physical_attrs 100 100  900  210 0 0 0>
            , <&key_physical_attrs 100 100 1000  200 0 0 0>
            , <&key_physical_attrs 100 100 1100  210 0 0 0>
            , <&key_physical_attrs 100 100 1200  230 0 0 0>
            , <&key_physical_attrs 100 100  300  370 0 0 0>
            , <&key_physical_attrs 100 100  400  370 0 0 0>
            , <&key_physical_attrs 100 150  500  320 0 0 0>
            , <&key_physical_attrs 100 150  700  320 0 0 0>
            , <&key_physical_attrs 100 100  800  370 0 0 0>
            , <&key_physical_attrs 100 100  900  370 0 0 0>
            ;
    };
};
